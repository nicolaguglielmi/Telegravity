# --- Required ---
# Get from @BotFather on Telegram
TELEGRAM_TOKEN=

# Your personal Telegram chat ID. Only this account can interact with the bot.
# Tip: message @userinfobot to discover yours.
AUTHORIZED_CHAT_ID=

# --- Optional: workspaces ---
# A "workspace" is a project the agent can be told to work on. Each carries a
# real directory so remote instructions and the exec tools target the right tree.
# Comma-separated initial labels (path resolved via auto-import / base dir):
INITIAL_WORKSPACES=

# Auto-import projects from Antigravity's registry (~/.gemini/config/projects/*.json),
# mapping each project name to its folder. Defaults to 1 (on).
# TELEGRAVITY_AUTOIMPORT=1
# Where that registry lives (defaults to ~/.gemini/config/projects):
# TELEGRAVITY_PROJECTS_DIR=/absolute/path
# Give bare workspace labels a path under this base dir (e.g. <base>/<label>):
# TELEGRAVITY_WORKSPACE_BASE=/Users/you/Dev
# You can also edit workspaces.txt in the data dir at runtime (hot-reloaded);
# each line is "Label=/abs/path" or a bare "Label".

# --- Optional: agent execution (jailed to the selected workspace) ---
# Allow shell commands: the Telegram confirm-tap flow AND the agent's run_command
# MCP tool. Defaults to 0. Only enable on a host you control.
ENABLE_SHELL_EXEC=0
# Allow reading files: the Telegram view AND the agent's read_file tool.
ENABLE_FILE_VIEW=0
# Allow the agent's write_file tool. Defaults to 0.
ENABLE_FILE_WRITE=0

# Override the data directory (state, conversations, logs). Defaults to ~/.telegravity.
# TELEGRAVITY_DATA_DIR=/absolute/path
