# --- Required ---
# Get from @BotFather on Telegram
TELEGRAM_TOKEN=

# Your personal Telegram chat ID. Only this account can interact with the bot.
# Tip: message @userinfobot to discover yours.
AUTHORIZED_CHAT_ID=

# --- Optional ---
# Comma-separated list of initial workspaces shown in the dashboard.
# You can also edit data/workspaces.txt at runtime (hot-reloaded).
INITIAL_WORKSPACES=

# Set to 1 to allow shell command execution via Telegram (always behind confirm tap).
# Defaults to 0 (disabled). Only enable on a host you control.
ENABLE_SHELL_EXEC=0

# Set to 1 to allow file viewing via Telegram (always restricted to the project tree).
# Defaults to 0 (disabled).
ENABLE_FILE_VIEW=0

# Override the data directory (state, conversations, logs). Defaults to ./data.
# TELEGRAVITY_DATA_DIR=/absolute/path
